###############################################################################
# GDF Internationals CRM — environment variables
#
# Copy this file to `.env` (local dev) and set the real values. On Vercel, add
# each of these under Project → Settings → Environment Variables instead.
# NEVER commit the real `.env` — only this `.env.example` belongs in git.
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# 1) DATABASE  (REQUIRED)  — MongoDB Atlas connection string
# ─────────────────────────────────────────────────────────────────────────────
# Atlas → Cluster → "Connect" → "Drivers" → copy the SRV string.
# Replace <user>, <password> (URL-encode special chars), and the host.
# The DB name goes after the host ("gdf_crm" below). Keep retryWrites=true&w=majority.
#
# DATA-1 tuning: cap the pool so Vercel's many concurrent lambdas don't exhaust
# Atlas connections. Start with maxPoolSize=10 (M10), raise/lower per tier limits.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/gdf_crm?retryWrites=true&w=majority&maxPoolSize=10"

# ─────────────────────────────────────────────────────────────────────────────
# 2) AUTH  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Secret used to sign/verify all JWT session cookies. Must be long & random.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If this is missing the app fails to start (getJwtSecret throws).
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"

# ─────────────────────────────────────────────────────────────────────────────
# 3) LOGIN / CRM OTP  (REQUIRED in production)
# ─────────────────────────────────────────────────────────────────────────────
# The inbox that RECEIVES login + CRM unlock one-time codes.
# Setting this enables the OTP second factor. If it is blank in production the
# app fails closed (SEC-1/SEC-2): logins return 503 until configured.
ADMIN_EMAIL="ops@gdfinternationals.com"

# Escape hatch ONLY. Set to "true" to intentionally run WITHOUT OTP in production
# (e.g. before SMTP is ready). Leave unset/false for normal secure operation.
# DISABLE_LOGIN_OTP="false"

# ─────────────────────────────────────────────────────────────────────────────
# 4) SMTP — sends the OTP emails to ADMIN_EMAIL  (REQUIRED in production)
#    Choose EITHER option A (Gmail) OR option B (generic SMTP host).
# ─────────────────────────────────────────────────────────────────────────────
# Option A — Gmail with an App Password (NOT your normal password):
#   Google Account → Security → 2-Step Verification (must be ON) →
#   App passwords → create one → use the 16-char value as SMTP_PASS.
SMTP_SERVICE="gmail"
SMTP_USER="your-sender@gmail.com"
SMTP_PASS="your-16-char-app-password"

# Option B — Generic SMTP provider (SendGrid, Mailgun, SES, etc.).
# Leave SMTP_SERVICE unset and use these instead:
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"          # 465 = implicit TLS, 587 = STARTTLS (default 587)
# SMTP_USER="apikey"
# SMTP_PASS="your-provider-password-or-api-key"

# Optional "From" header for outgoing mail (defaults to "Bee CRM <SMTP_USER>").
# SMTP_FROM="GDF CRM <no-reply@gdfinternationals.com>"

# ─────────────────────────────────────────────────────────────────────────────
# 5) CLOUDINARY — file/image uploads (lead CSVs, profile photos, lead docs)
#    REQUIRED for any upload feature; uploads return 503 if missing.
# ─────────────────────────────────────────────────────────────────────────────
# Cloudinary Dashboard → "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─────────────────────────────────────────────────────────────────────────────
# 6) UPSTASH REDIS — distributed rate limiting (SEC-5 / SEC-10)  (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────
# Without these the app uses an in-memory limiter (fine for a single instance,
# but ineffective across Vercel's many lambdas). To make limits hold globally:
#   1. https://console.upstash.com → create a Redis database. Pick the region where
#      the AUTH routes run (they use the project default region, NOT the bom1-pinned
#      data routes). For a Vercel project in iad1, choose AWS us-east-1 (N. Virginia).
#   2. Open the database → "REST API" section → copy UPSTASH_REDIS_REST_URL and
#      UPSTASH_REDIS_REST_TOKEN.
# (Tip: the Vercel "Upstash" integration can inject these automatically.)
UPSTASH_REDIS_REST_URL="https://your-db-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# ─────────────────────────────────────────────────────────────────────────────
# 7) RUNTIME (OPTIONAL — usually set by the platform, not you)
# ─────────────────────────────────────────────────────────────────────────────
# NODE_ENV="production"   # Vercel/Next set this automatically
# PORT="3000"             # standalone server only (server.js)
# HOSTNAME="0.0.0.0"      # standalone server only
